{
  "name": "biblioteca-api",
  "version": "1.0.0",
  "description": "API REST + interface web de uma biblioteca, feita para aulas de automação de testes com Playwright",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^18.19.0",
    "@types/swagger-ui-express": "^4.1.6",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
